@font-face {
  font-family: "Roboto";
  src: url(Roboto-VariableFont_wdth\,wght.ttf)
}

body {
  font-family: "Roboto";
  margin: 0;
}

header,
footer,
.hero {
  background-color: #1F2937;
}


header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  color: #F9FAF8;
  padding: 20px 300px;
}

header a:visited {
  color: #F9FAF8;
  text-decoration: none;
}

.logo-text {
  font-size: 24px;
  font-weight: 900;
}

.hero {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 120px 300px 180px 300px;
}

.hero-text {
  width: 450px;
  height: 300px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
}

.hero-image {
  height: 300px;
  width: 700px;
  background-color: #E5E7EB;
}

.hero-text>h1 {
  font-size: 48px;
  color: #F9FAF8;
  font-weight: 900;
  margin: 0;
}

.hero-text>p {
  font-size: 18px;
  color: #E5E7EB;
  margin: 0;
}

.hero-text>button {
  color: #F9FAF8;
  font-size: 18px;
  padding: 8px;
  border-radius: 8px;
  border: 0 none #F9FAF8;
  /* Don't know how to inline a block */
  display: inline-block;
  width: 160px;
}


button,
.call-to-action {
  background-color: #3882F6;
}

.information {
  padding: 60px 0 150px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.information-container {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 60px;
  width: 200px;
}

.information>h1 {
  font-size: 36px;
  font-weight: 900;
  color: #1F2937;
}

.information-box {
  color: #1F2937;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.information-box>p {
  margin: 10px 0 0 0;
}

.information-image {
  height: 200px;
  width: 200px;
  border: 4px solid #3882F6;
  border-radius: 18px;
}

.quote {
  background-color: #E5E7EB;
  font-size: 36px;
  font-weight: 300px;
  font-style: italic;
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-direction: column;
  padding: 150px 500px 180px 500px;
}

.quote>p {
  margin: 0px;
}

.quote-author {
  font-size: 24px;
  color: #1F2937;
  font-weight: bold;
  font-style: normal;
  text-align: right;
}
